import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

class Card {
    String symbol;
    String value;

    Card(String symbol, String value) {
        this.symbol = symbol;
        this.value = value;
    }

    public String toString() {
        return "Symbol: " + symbol + ", Value: " + value;
    }
}

public class CardCollection {
    private List<Card> cards;

    public CardCollection() {
        cards = new ArrayList<>();
    }

    public void addCard(String symbol, String value) {
        cards.add(new Card(symbol, value));
        System.out.println("Card added successfully.");
    }

    public void removeCard(String symbol, String value) {
        boolean removed = cards.removeIf(card -> card.symbol.equals(symbol) && card.value.equals(value));
        if (removed) {
            System.out.println("Card removed successfully.");
        } else {
            System.out.println("Card not found.");
        }
    }

    public void searchCardsBySymbol(String symbol) {
        List<Card> foundCards = new ArrayList<>();
        for (Card card : cards) {
            if (card.symbol.equals(symbol)) {
                foundCards.add(card);
            }
        }

        if (foundCards.isEmpty()) {
            System.out.println("No cards found with the symbol: " + symbol);
        } else {
            System.out.println("Cards with the symbol " + symbol + ":");
            for (Card card : foundCards) {
                System.out.println(card);
            }
        }
    }

    public static void main(String[] args) {
        CardCollection cardCollection = new CardCollection();
        Scanner scanner = new Scanner(System.in);

        while (true) {
            System.out.println("\nCard Collection System");
            System.out.println("1. Add Card");
            System.out.println("2. Remove Card");
            System.out.println("3. Search Cards by Symbol");
            System.out.println("4. Exit");
            System.out.print("Enter your choice: ");
            int choice = scanner.nextInt();
            scanner.nextLine(); // Consume newline

            switch (choice) {
                case 1:
                    System.out.print("Enter Symbol: ");
                    String symbol = scanner.nextLine();
                    System.out.print("Enter Value: ");
                    String value = scanner.nextLine();
                    cardCollection.addCard(symbol, value);
                    break;
                case 2:
                    System.out.print("Enter Symbol: ");
                    symbol = scanner.nextLine();
                    System.out.print("Enter Value: ");
                    value = scanner.nextLine();
                    cardCollection.removeCard(symbol, value);
                    break;
                case 3:
                    System.out.print("Enter Symbol to search: ");
                    symbol = scanner.nextLine();
                    cardCollection.searchCardsBySymbol(symbol);
                    break;
                case 4:
                    System.out.println("Exiting...");
                    scanner.close();
                    return;
                default:
                    System.out.println("Invalid choice. Please try again.");
            }
        }
    }
}
